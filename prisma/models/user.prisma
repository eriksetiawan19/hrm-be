model User {
  id        String    @id @default(ulid())
  email     String    @unique
  password  String
  name      String
  photo     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
}
