model Permission {
  id           String    @id @default(ulid())
  group        String    @db.VarChar(50)
  name         String    @unique @db.VarChar(50)
  description  String?   @db.Text
  order        Int?
  orderInGroup Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  roles RolePermission[]
}
